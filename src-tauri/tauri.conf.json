{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auctioneer",
  "version": "0.1.0",
  "identifier": "app.auctioneer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Auctioneer",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Felipe Souza",
    "category": "Utility",
    "copyright": "© 2026 Felipe Souza",
    "homepage": "https://github.com/Fm-s/wow-forever-auction-partner",
    "shortDescription": "Auction house tracker for WoW Forever",
    "longDescription": "Auctioneer tracks World of Warcraft Forever auction house prices and volume from the Blizzard API, with history charts, item groups and cross-house comparison.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
