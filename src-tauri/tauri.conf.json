{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WoW Forever Auction Partner",
  "mainBinaryName": "wow-forever-auction-partner",
  "version": "0.1.1",
  "identifier": "app.auctioneer.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WoW Forever Auction Partner",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Felipe Souza",
    "category": "Utility",
    "copyright": "© 2026 Felipe Souza",
    "homepage": "https://github.com/Fm-s/wow-forever-auction-partner",
    "shortDescription": "Auction house tracker for WoW Forever",
    "longDescription": "WoW Forever Auction Partner tracks World of Warcraft: Forever auction house prices and volume (any realm type, US or EU) from the Blizzard API, with history charts, item groups and cross-house comparison.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5NUJBQjlGMkNCQUNFRTQKUldUa3pyb3NuNnRiaVhYazBzb2dIKzZ3NStqNmV1Qm0vTk9Gd0tCOHhuanBlYnZzVTBuMVkxclgK",
      "endpoints": [
        "https://github.com/Fm-s/wow-forever-auction-partner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
